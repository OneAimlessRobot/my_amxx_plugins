//----------------------------------------------------------------------------------------------
public plugin_init()
{
	// Plugin Info
	register_plugin("SUPERHERO Sablina", "1.0", AUTHOR)
	
	
	// DO NOT EDIT THIS FILE TO CHANGE CVARS, USE THE SHCONFIG.CFG
	create_cvar("sablina_level", "14")
	pcvar_sablina_spike_radius = create_cvar("sablina_spike_radius", "400.0")
	pcvar_sablina_spike_dmg = create_cvar("sablina_spike_dmg", "125.0")
	pcvar_sablina_spike_cooldown = create_cvar("sablina_spike_cooldown", "30.0")
	pcvar_sablina_spike_charge_max = create_cvar("sablina_spike_charge_max", "5.0")
	pcvar_sablina_spike_charge_pct_min = create_cvar("sablina_spike_charge_pct_min", "0.3")
	pcvar_sablina_spike_knockback = create_cvar("sablina_spike_knockback", "1250.0")
	pcvar_sablina_spike_stun_duration = create_cvar("sablina_spike_stun_duration", "20.0")
	
	//this fraction of the peak dmg from spike will be removed from hp!
	pcvar_sablina_dmg_frac_hp_cut = create_cvar("sablina_dmg_frac_hp_cut", "0.5")

	
	set_pcvar_bounds(pcvar_sablina_spike_radius,CvarBound_Lower,true, 100.0)
	set_pcvar_bounds(pcvar_sablina_spike_dmg,CvarBound_Lower,true, 40.0)
	set_pcvar_bounds(pcvar_sablina_spike_charge_pct_min,CvarBound_Upper,true, 0.9)
	set_pcvar_bounds(pcvar_sablina_spike_charge_pct_min,CvarBound_Lower,true, 0.2)
	set_pcvar_bounds(pcvar_sablina_dmg_frac_hp_cut,CvarBound_Upper,true, 0.9)
	set_pcvar_bounds(pcvar_sablina_dmg_frac_hp_cut,CvarBound_Lower,true, 0.2)
	
	RegisterHam(Ham_TraceAttack,"player","sablina_ethereal_body",_,true)

	RegisterHam( Ham_Touch, "armoury_entity", "fw_HamPlayerTouchPre" );
	RegisterHam( Ham_Touch, "weaponbox", "fw_HamPlayerTouchPre" );

	gHeroID=shCreateHero(gHeroName, "Stone probe!", "Summon stone spikes to damage your enemies! Become ethereal, too", true, "sablina_level" )
	
	stone_spike_wpn_id=sh_log_custom_damage_source(
								gHeroID,
								stone_spike_short_name,
								stone_spike_long_name,
								0)

	sablina_stone_spike_recoil_wpn_id=sh_log_custom_damage_source(
								gHeroID,
								sablina_stone_spike_recoil_short_name,
								sablina_stone_spike_recoil_log_name,
								0)

	register_forward(FM_CmdStart,"fw_Sablina_unnarmed")
	RegisterHam(Ham_TraceAttack,"player","sablina_untracer",_,true)
	register_forward(FM_UpdateClientData, "fm_UpdateClientDataPost", 1)
	register_event("CurWeapon", "sablina_destroy_guys_on_deploy", "be", "1=1")

	sh_register_hero_healthcap(gHeroID, 130.0)

	sh_assign_hero_bit(gHeroID, SH_HITBOX_MANIP_HERO, true)

	sh_assign_hero_bit(gHeroID, SH_ANTI_GRENADES_HERO, true)

	sh_assign_hero_bit(gHeroID, SH_ANTI_FALL_DAMAGE_HERO, true)

	register_think(SABLINA_SPIKER_CLASSNAME,"sablina_spike_think")

	init_progress_bar_msg_var()

	SH_SABLINA_SPIKE_CHARGE_TASKID = allocate_typed_task_id(player_task)
	SH_SABLINA_SPIKE_DIE_TASKID = allocate_typed_task_id(entity_task)
	
	
	
}


public fw_HamPlayerTouchPre( iEntity, iPlayer ) {
	if( !is_user_alive( iPlayer ) ){
		return HAM_IGNORED;
	}
	
	set_pdata_int( iPlayer, m_iHideHUD, ( 1 << 3 ) ,XO_PLAYER);
	
	static szModel[ 23 ];
	entity_get_string( iEntity, EV_SZ_model, szModel, charsmax( szModel ) );
	
	if(containi( szModel, "w_backpack" ) != -1 || !sh_get_user_has_hero(iPlayer,gHeroID)){
		return HAM_IGNORED;
	}
	
	return HAM_SUPERCEDE;
}


public sablina_destroy_guys_on_deploy(id)
{
	if (!sh_is_active()) return
	
	if (!sh_is_inround()) return

	if (sh_is_freezetime()) return
	
	if(!sh_get_user_has_hero(id,gHeroID)) return

	new wpn_id = read_data(2)
	if(!SABLINA_CAN_USE_WPN(wpn_id)){
		sh_drop_weapon(id,wpn_id,false)
	}
	if((wpn_id!=CSW_KNIFE)&&Get_BitVar(stone_spike_active_mask,id)){

		user_last_weapon[id] = wpn_id;
		Assign_BitVar(sablina_switched_weapon_mask,id,true_for_macro)
		sh_switch_weapon(id, CSW_KNIFE)
	}

}


public fm_UpdateClientDataPost(player, sendWeapons, cd)
{
	
	if(!is_user_alive(player)){
		return FMRES_IGNORED
	}

	if(!sh_get_user_has_hero(player,gHeroID)){

		return FMRES_IGNORED
	}
	new weapon = get_user_weapon(player);
	if(SABLINA_CAN_USE_WPN(weapon)){
		return FMRES_IGNORED
	}
	
	new pEntity = get_pdata_cbase(player, m_pActiveItem, XO_PLAYER)
	if(pev_valid(pEntity)==PDATA_SAFE){

		new is_silenced=cs_get_weapon_silen(pEntity)
		if(!is_silenced){
			set_cd(cd, CD_flNextAttack, get_gametime()+1.0)
			return FMRES_HANDLED
		}
	}	
	return FMRES_IGNORED
}

public sablina_untracer(this, idattacker, Float:damage, Float:direction[3], traceresult, damagebits)
{
	if(damage<=0.0){
		return HAM_IGNORED
	}
	if ( !sh_is_active()) return HAM_IGNORED
	
	if ( !is_user_alive(idattacker)) {
		return HAM_IGNORED
	}
	if(!sh_get_user_has_hero(idattacker,gHeroID)){

		return HAM_IGNORED
	}
	new weapon=get_user_weapon(idattacker)
	if(!SABLINA_CAN_USE_WPN(weapon)){
		
		damage=0.0
		SetHamParamFloat(3,damage)
		return HAM_HANDLED
	}
	return HAM_IGNORED
}

public fw_Sablina_unnarmed(id, uc_handle)
{
	if(!sh_is_active()||sh_is_freezetime()){
		return FMRES_IGNORED
	}
	if (!is_user_alive(id)){
		return FMRES_IGNORED
	}
	
	if(!sh_get_user_has_hero(id,gHeroID)){

		return FMRES_IGNORED
	}
	new bool:removed_attack = false;
	new button = get_uc(uc_handle, UC_Buttons);
	if(button & IN_ATTACK)
	{
		new weapon_id = get_user_weapon(id)
		if(!SABLINA_CAN_USE_WPN(weapon_id)){
			
			button &= ~IN_ATTACK;
			set_uc(uc_handle, UC_Buttons, button);
			removed_attack = true
		}
		
	}

	new Float:fwd_movement,
			Float:side_movement,
			Float:up_movement

	get_uc(uc_handle, UC_ForwardMove, fwd_movement);
	get_uc(uc_handle, UC_SideMove, side_movement);
	get_uc(uc_handle, UC_UpMove, up_movement);

	new full_movement_mask = (IN_MOVELEFT|IN_MOVERIGHT|IN_FORWARD|IN_BACK|IN_LEFT|IN_RIGHT|IN_DUCK|IN_RUN)
	/*
	
		if any one of these is being pressed...
	
	
	*/
	if(sh_get_cooldown_flag(id)&&(button & full_movement_mask)){

		button &= full_movement_mask
		set_uc(uc_handle, UC_Buttons, button);
		set_uc(uc_handle, UC_ForwardMove,fwd_movement*0.0);
		set_uc(uc_handle, UC_SideMove,side_movement*0.0);
		set_uc(uc_handle, UC_UpMove,up_movement*0.0);
		set_user_maxspeed_controlled(id,0.0,true,false)
		return FMRES_SUPERCEDE

	}
	return (removed_attack?FMRES_SUPERCEDE:FMRES_IGNORED)
}


public plugin_natives(){

	register_native("sablina_get_hero_id","_sablina_get_hero_id")
}
public plugin_precache(){


	engfunc(EngFunc_PrecacheSound,gSoundSummon)
	engfunc(EngFunc_PrecacheSound,gSoundThunder)
	engfunc(EngFunc_PrecacheSound,gSoundRockCrash)
	engfunc(EngFunc_PrecacheSound,SPIKE_CHARGING_SOUND)
	engfunc(EngFunc_PrecacheModel,sablina_rock_spike_mdl_name)
}
//----------------------------------------------------------------------------------------------
public sh_hero_key(id, heroID, sh_key_mode:key)
{
	if ( gHeroID != heroID ||!sh_get_user_has_hero(id,gHeroID) ) return

	switch(key)
	{
		case SH_KEYDOWN: {
			sablina_kd(id)
		}
		case SH_KEYUP: {
			sablina_ku(id)
		}
	}
}
cancel_sablina_strike(id){


	sablina_delete_charging_sound(id)

	set_user_maxspeed_controlled(id, user_last_maxspeed[id],true, true)

	sh_assign_id_bit(id, SH_IS_CHARGING_HEAVY_ATTACK, false)


	Assign_BitVar(stone_spike_active_mask,id,false_for_macro)


}

public sablina_ethereal_body(id, attacker, Float:damage, Float:direction[3], tracehandle, damagebits){

	if(damage<=0.0){
		return HAM_IGNORED
	}
	if(!is_user_alive(id)){

		return HAM_IGNORED;

	}
	if(!sh_get_user_has_hero(id,gHeroID) ){

		return HAM_IGNORED;

	}
	if(sh_clients_are_same_team(id,attacker)){

		return HAM_IGNORED
	}
	return HAM_SUPERCEDE
}
public increase_dmg_task(id){

	id-=SH_SABLINA_SPIKE_CHARGE_TASKID

	if(!sh_is_active()||sh_is_freezetime()||!is_user_alive(id)||!sh_get_user_has_hero(id,gHeroID)||!Get_BitVar(stone_spike_active_mask,id)){


		cancel_sablina_strike(id)
		return;
	}
	
	if(user_stone_spiker_time[id]< cvar_val(float, pcvar_sablina_spike_charge_max)){



		user_stone_spiker_time[id] += SABLINA_STONE_SPIKE_TICK_LENGTH_SECS
		client_print(id,print_center,"[SH] Sablina: Stone spike charge: %0.2f",user_stone_spiker_time[id]/cvar_val(float, pcvar_sablina_spike_charge_max))

		set_task(SABLINA_STONE_SPIKE_TICK_LENGTH_SECS,"increase_dmg_task",id+SH_SABLINA_SPIKE_CHARGE_TASKID)
		return
		
	}


}

//----------------------------------------------------------------------------------------------
// RESPOND TO KEYDOWN
public sablina_kd(id)
{
	if ( !sh_is_inround() || sh_is_freezetime()) return

	if ( !is_user_alive(id) || !sh_get_user_has_hero(id,gHeroID)  ) return

	if ( sh_get_cooldown_flag(id)) {
		
		if(!is_user_bot(id)){

			sh_sound_deny(id)
		}
		return
	}

	user_last_maxspeed[id] = get_user_maxspeed(id)

	sh_assign_id_bit(id, SH_IS_CHARGING_HEAVY_ATTACK, true)

	set_user_maxspeed_controlled(id, 100.0,true, false)

	
	user_stone_spiker_time[id] = 0.0;
		
	emit_sound(id, CHAN_ITEM, SPIKE_CHARGING_SOUND, VOL_NORM, ATTN_NORM, 0, PITCH_NORM)

	progressBar(id, floatround(cvar_val(float, pcvar_sablina_spike_charge_max) * 1.0,floatround_round))

	Assign_BitVar(stone_spike_active_mask,id,true_for_macro)
	increase_dmg_task(id+SH_SABLINA_SPIKE_CHARGE_TASKID);
}
sablina_delete_charging_sound(id){

	if(is_user_connected(id)){
		emit_sound(id, CHAN_ITEM, NULL_SOUND, VOL_NORM, ATTN_NORM, 0, PITCH_NORM)
		emit_sound(id, CHAN_ITEM, SPIKE_CHARGING_SOUND, VOL_NORM, ATTN_NORM, SND_STOP, PITCH_NORM)
	}
}
public sablina_ku(id)
{
	if ( !sh_is_inround()  || sh_is_freezetime()) return

	if ( !is_user_alive(id) || !sh_get_user_has_hero(id,gHeroID)  ) return

	progressBar(id, 0)

	
	if ( (user_stone_spiker_time[id]/cvar_val(float, pcvar_sablina_spike_charge_max)) < cvar_val(float, pcvar_sablina_spike_charge_pct_min) ) {
		
		cancel_sablina_strike(id)

		
		if(!is_user_bot(id)){

			sh_sound_deny(id)
		}
		return
	}
	if(Get_BitVar(stone_spike_active_mask,id)){

		if(Get_BitVar(sablina_switched_weapon_mask,id)){
			// Switch back to previous weapon... Only if power was used...
			if (user_last_weapon[id] != CSW_KNIFE){
				
				shSwitchWeaponID(id, user_last_weapon[id])
				
			}

			Assign_BitVar(sablina_switched_weapon_mask,id,false_for_macro)
		}

		sablina_strike(id)

		sh_set_cooldown(id, cvar_val(float, pcvar_sablina_spike_cooldown) * 1.0 )
	}
	cancel_sablina_strike(id)

}
put_object_on_wall_from_aimer(aimer_id,ent_id, Float:in_and_out_vec[3]){


	static Float:vOrigin[3]
	pev(aimer_id, pev_origin, vOrigin)
	
	static Float:vTraceDirection[3], Float:vTraceEnd[3],  Float:vNormal[3]
	
	velocity_by_aim(aimer_id, 9999, vTraceDirection)
	vTraceEnd[0] = vTraceDirection[0] + vOrigin[0]
	vTraceEnd[1] = vTraceDirection[1] + vOrigin[1]
	vTraceEnd[2] = vTraceDirection[2] + vOrigin[2]
	
	new Float:fraction, tr = 0
	engfunc(EngFunc_TraceLine, vOrigin, vTraceEnd, 0, aimer_id, tr)
	get_tr2(tr, TR_vecEndPos, in_and_out_vec)
	get_tr2(tr, TR_vecPlaneNormal, vNormal)
	get_tr2(tr, TR_flFraction, fraction)

	free_tr2(tr)
	
	engfunc(EngFunc_SetOrigin, ent_id, in_and_out_vec)
	entity_set_vector(ent_id,EV_VEC_vuser2,in_and_out_vec)
	
}
public sablina_spike_think(ent_id){


	if ( !is_valid_ent(ent_id) ) return PLUGIN_CONTINUE

	new owner_id = entity_get_edict(ent_id,EV_ENT_owner)
	//if(!is_user_alive(owner_id)||(!(entity_get_int(ent_id, EV_INT_flags)& FL_PARTIALGROUND))){
	if(!is_user_alive(owner_id)){

		draw_bbox(ent_id,1)
		remove_entity(ent_id)

		return PLUGIN_CONTINUE;
	}

	new Float:the_radius = 5.0,
					Float:the_damage = 1.0,
					Float:charge_pct = 0.2,
					Float:the_knockback = 1.0,
					Float:the_stun_duration = 1.0;

	charge_pct=(user_stone_spiker_time[owner_id]/cvar_val(float, pcvar_sablina_spike_charge_max))

	the_damage = floatmin(( cvar_val(float,pcvar_sablina_spike_dmg) * charge_pct), 
						( cvar_val(float,pcvar_sablina_dmg_frac_hp_cut) * sh_get_player_healthcap(owner_id) ) )

	the_radius = ( cvar_val(float,pcvar_sablina_spike_radius) * charge_pct)
	the_knockback = ( cvar_val(float,pcvar_sablina_spike_knockback) * charge_pct)
	the_stun_duration = ( cvar_val(float, pcvar_sablina_spike_stun_duration) * charge_pct)


	emit_sound(ent_id, CHAN_STATIC, gSoundSummon, 1.0, ATTN_NORM, 0, PITCH_NORM)

	static entlist[33];
	new numfound = find_sphere_class(ent_id,"player",
					the_radius,
					entlist,
					charsmax(entlist));

	for( new i= 0;(i< numfound);i++){

		new pid = entlist[i];
		if( !is_user_alive(pid) || (pid==owner_id) || sh_clients_are_same_team(pid,owner_id)){
		
			continue
		
		}
		emit_sound(pid, CHAN_STATIC, gSoundThunder, 1.0, ATTN_NORM, 0, PITCH_NORM)
		directed_spark(ent_id,pid,30,5,255,0,PURPLE,15)
		sh_set_stun(pid,the_stun_duration,50.0)
	}
	
	new Float:aim_orig[3]
	entity_get_vector(ent_id, EV_VEC_vuser2,aim_orig)

	tank_impact_shot_fx(ent_id,aim_orig,
				floatround(0.04*the_radius),255)
	
	explosion(gHeroID,ent_id,the_radius,the_damage,the_knockback,1,1,_,
				explosion_sfx_show_burn_decal|explosion_sfx_show_shockwave|explosion_sfx_show_custom_sound,
										PURPLE,gSoundRockCrash,stone_spike_wpn_id)

	explosion_custom_entity(ent_id,
							the_radius,
							the_damage,
							"func_breakable",
							the_knockback)
	
	sh_extra_damage(owner_id,owner_id,floatround(the_damage,floatround_ceil),
					_,_,_,_,_,
					SH_NEW_DMG_DRAIN,
					sablina_stone_spike_recoil_wpn_id)

	client_print(owner_id,print_console,"Attack dimensions:^ndamagae: %0.2f^nradius: %0.2f^n",the_damage,the_radius)

	set_task(SABLINA_STONE_SPIKE_DIE_DELAY,"sablina_stone_spike_die_delayed",ent_id+SH_SABLINA_SPIKE_DIE_TASKID)
	
	return PLUGIN_CONTINUE

}
sablina_strike(id){


	new Float:aim_orig[3]
	new ent_id = create_entity("info_target")
	if (!is_valid_ent(ent_id)){
		console_print(id,"Error while creating hitter entity!^n")
		return    
	}

	entity_set_string(ent_id, EV_SZ_classname, SABLINA_SPIKER_CLASSNAME)
	entity_set_edict(ent_id,EV_ENT_owner,id)
	entity_set_model(ent_id,sablina_rock_spike_mdl_name)

	entity_set_vector(ent_id, EV_VEC_mins, spike_min_dims)
	entity_set_vector(ent_id, EV_VEC_maxs, spike_max_dims)


	entity_set_int(ent_id, EV_INT_effects, 2)
	entity_set_int(ent_id, EV_INT_solid, SOLID_BBOX)
	
	put_object_on_wall_from_aimer(id,ent_id,aim_orig)

	draw_bbox(ent_id,0)

	entity_set_float(ent_id,EV_FL_nextthink,get_gametime()+0.3)
	

}
public sablina_stone_spike_die_delayed(ent_id){

	ent_id-=SH_SABLINA_SPIKE_DIE_TASKID

	if(is_valid_ent(ent_id)){

		draw_bbox(ent_id,1)
		remove_entity(ent_id)

	}

}
public _sablina_get_hero_id(iPlugins, iParams){


	return gHeroID;

}


public sh_round_new(){


	stone_spike_active_mask = 0;
	remove_entity_name(SABLINA_SPIKER_CLASSNAME)


}
//----------------------------------------------------------------------------------------------
public sh_client_spawn(id)
{	
	if(sh_is_active()){
		if ( sh_get_user_has_hero(id,gHeroID) ) {
			

			sh_unset_cooldown_flag(id)
			sh_end_cooldown(id+SH_COOLDOWN_TASKID)
			Assign_BitVar(stone_spike_active_mask,id,false_for_macro)
		}
	}
	
}
//----------------------------------------------------------------------------------------------
public sh_client_death(id)
{	
	if(sh_is_active()){
		if ( sh_get_user_has_hero(id,gHeroID) ) {
			

			Assign_BitVar(stone_spike_active_mask,id,false_for_macro)
		}
	}
	
}
