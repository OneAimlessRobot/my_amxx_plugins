public on_Weapon_Change(id)
{
	if (!sh_is_active()) return
	if(!sh_get_user_has_hero(id,gHeroID)) return

	new user_wpn = read_data(2)
	if(Get_BitVar(stone_spike_active_mask, id) && !(wpn_id_in_bs( user_wpn , ( single_wpn_bs( CSW_KNIFE ) ) ) ) ){
		cancel_sablina_strike(id)
	}

}
Float:get_sablina_health_ratio(Float:the_current, Float:the_cap){

	return floatclamp(( the_current/ the_cap),0.1,0.99)

}
Float:calculate_sablina_charge_time(id){

	return (cvar_val(float, pcvar_sablina_spike_charge_time_min)
							
							+

	((cvar_val(float, pcvar_sablina_spike_charge_time_max) - cvar_val(float, pcvar_sablina_spike_charge_time_min))
		
						*
					get_sablina_health_ratio(entity_get_float(id, EV_FL_health),float(sh_get_max_hp(id)))))

}
Float:calculate_sablina_cooldown_time(id){


	return (cvar_val(float, pcvar_sablina_spike_min_cooldown) 
										
										+

				((cvar_val(float, pcvar_sablina_spike_max_cooldown) - cvar_val(float, pcvar_sablina_spike_min_cooldown) )
					
									*
					get_sablina_health_ratio(entity_get_float(id, EV_FL_health),float(sh_get_max_hp(id)))))
}
//----------------------------------------------------------------------------------------------
public sablina_loop(taskid)
{	
	if ( !sh_is_active() || sh_is_freezetime() ) return

	new the_players[SH_MAXSLOTS], pnum, id		
	get_players(the_players, pnum, "a")
	for (new i = 0; i < pnum; i++) {
		
		id = the_players[i]


		new Float:the_healthcap = float(sh_get_max_hp(id)),
			Float:the_current_health = 0.0,
			Float:the_alpha_floated  = 0.0,
			the_actual_alpha = 0
		
		if ( !sh_get_user_has_hero(id,gHeroID)){
			
			continue
		
		}
		the_current_health = Get_BitVar(stone_spike_out_of_breath,id) ? user_health_after_last_strike[id] : entity_get_float(id,EV_FL_health)
		
		the_alpha_floated = 
						
						cvar_val(float, pcvar_sablina_rendering_min_alpha)
										
										+

				((cvar_val(float, pcvar_sablina_rendering_max_alpha) - cvar_val(float, pcvar_sablina_rendering_min_alpha))
					
									*
					get_sablina_health_ratio(the_current_health,the_healthcap))




		the_actual_alpha = floatround( the_alpha_floated, floatround_round)

		set_render_with_color_const(id,LAVENDER,1,the_actual_alpha,
							20,
							_,_,
							SABLINA_TASK_PERIOD,0)

	}
}

public fw_HamPlayerTouchPre( iEntity, iPlayer ) {
	if( !is_user_alive( iPlayer ) ){
		return HAM_IGNORED;
	}
	
	
	static szModel[ 23 ];
	entity_get_string( iEntity, EV_SZ_model, szModel, charsmax( szModel ) );
	
	if(containi( szModel, "w_backpack" ) != -1 || !sh_get_user_has_hero(iPlayer,gHeroID)){
		return HAM_IGNORED;
	}
	
	return HAM_SUPERCEDE;
}

public fm_UpdateClientDataPost(player, sendWeapons, cd)
{
	
	if(!is_user_alive(player)){
		return FMRES_IGNORED
	}

	if(!sh_get_user_has_hero(player,gHeroID)){

		return FMRES_IGNORED
	}
	new weapon = get_user_weapon(player);
	if(SABLINA_CAN_USE_WPN(weapon)){
		return FMRES_IGNORED
	}
	
	new pEntity = get_pdata_cbase(player, m_pActiveItem, XO_PLAYER)
	if(pev_valid(pEntity)==PDATA_SAFE){

		new is_silenced=cs_get_weapon_silen(pEntity)
		if(!is_silenced){
			set_cd(cd, CD_flNextAttack, get_gametime()+1.0)
			return FMRES_HANDLED
		}
	}	
	return FMRES_IGNORED
}


public fw_Sablina_unnarmed(id, uc_handle)
{
	if(!sh_is_active()||sh_is_freezetime()){
		return FMRES_IGNORED
	}
	if (!is_user_alive(id)){
		return FMRES_IGNORED
	}
	
	if(!sh_get_user_has_hero(id,gHeroID)){

		return FMRES_IGNORED
	}
	new bool:removed_attack = false;
	new button = get_uc(uc_handle, UC_Buttons);
	if(button & IN_ATTACK)
	{
		new weapon_id = get_user_weapon(id)
		if(!SABLINA_CAN_USE_WPN(weapon_id)){
			
			button &= ~IN_ATTACK;
			set_uc(uc_handle, UC_Buttons, button);
			removed_attack = true
		}
		
	}
	return (removed_attack?FMRES_SUPERCEDE:FMRES_IGNORED)
}


public plugin_natives(){

	register_native("sablina_get_hero_id","_sablina_get_hero_id")
}
public plugin_precache(){

	engfunc(EngFunc_PrecacheModel, sablina_rock_spike_mdl_name)
	for( new i =0; i< sizeof(gRockCrashSounds);i++){

		engfunc(EngFunc_PrecacheSound,gRockCrashSounds[i])
	
	}
	engfunc(EngFunc_PrecacheSound,SPIKE_CHARGING_SOUND)
}

//----------------------------------------------------------------------------------------------
public sh_hero_init(id, heroID, sh_init_mode:mode){
    if(heroID!=gHeroID) return

    if(mode==SH_HERO_ADD){

		sh_chat_message(id,gHeroID,"Warning: Any firearms you carry will get destroyed in the start of the next round")
		
		
	}

}

//----------------------------------------------------------------------------------------------
public sh_hero_key(id, heroID, sh_key_mode:key)
{
	if ( gHeroID != heroID ||!sh_get_user_has_hero(id,gHeroID) ) return

	switch(key)
	{
		case SH_KEYDOWN: {
			sablina_kd(id)
		}
		case SH_KEYUP: {
			sablina_ku(id)
		}
	}
}
cancel_sablina_strike(id){


	progressBar(id, 0)

	sablina_delete_charging_sound(id)

	set_user_maxspeed_controlled(id, user_last_maxspeed[id],true, true)

	sh_assign_id_bit(id, SH_IS_CHARGING_HEAVY_ATTACK, false)


	Assign_BitVar(stone_spike_active_mask,id,false_for_macro)


}

public sablina_ethereal_body(id, attacker, Float:damage, Float:direction[3], tracehandle, damagebits){

	if(damage<=0.0){
		return HAM_IGNORED
	}
	if(!is_user_alive(id)){

		return HAM_IGNORED;

	}
	if(!sh_get_user_has_hero(id,gHeroID) ){

		return HAM_IGNORED;

	}
	if(sh_clients_are_same_team(id,attacker)){

		return HAM_IGNORED
	}

	damage=0.0
	SetHamParamFloat(3,damage)
	return HAM_SUPERCEDE
}
public increase_dmg_task(id){

	id-=SH_SABLINA_SPIKE_CHARGE_TASKID

	if(!sh_is_active()||sh_is_freezetime()||!is_user_alive(id)||!sh_get_user_has_hero(id,gHeroID)||!Get_BitVar(stone_spike_active_mask,id)){


		cancel_sablina_strike(id)
		return;
	}
	
	if(user_stone_spiker_time[id]< user_charge_time_curr_strike[id]){


		
		
		set_user_maxspeed_controlled(id, 100.0,true, false)
		
		user_stone_spiker_time[id] += (floatmin(user_charge_time_curr_strike[id]-user_stone_spiker_time[id],SABLINA_STONE_SPIKE_TICK_LENGTH_SECS))
		
		client_print(id,print_center,"[SH] Sablina: Stone spike charge: %0.2f",user_stone_spiker_time[id]/user_charge_time_curr_strike[id])

		set_task(SABLINA_STONE_SPIKE_TICK_LENGTH_SECS,"increase_dmg_task",id+SH_SABLINA_SPIKE_CHARGE_TASKID)
		return
		
	}


}

//----------------------------------------------------------------------------------------------
// RESPOND TO KEYDOWN
public sablina_kd(id)
{
	if ( !sh_is_inround() || sh_is_freezetime()) return

	if ( !is_user_alive(id) || !sh_get_user_has_hero(id,gHeroID)  ) return

	if ( sh_get_cooldown_flag(id)) {
		
		if(!is_user_bot(id)){

			sh_sound_deny(id)
		}
		return
	}

	user_last_maxspeed[id] = get_user_maxspeed(id)

	sh_assign_id_bit(id, SH_IS_CHARGING_HEAVY_ATTACK, true)


	user_last_weapon[id] = get_user_weapon(id)
	sh_switch_weapon(id, CSW_KNIFE)
	Assign_BitVar(sablina_switched_weapon_mask,id,true_for_macro)

	
	user_stone_spiker_time[id] = 0.0;
		
	emit_sound(id, CHAN_ITEM, SPIKE_CHARGING_SOUND, VOL_NORM, ATTN_NORM, 0, PITCH_NORM)

	user_charge_time_curr_strike[id] = calculate_sablina_charge_time(id)

	progressBar(id, floatround(user_charge_time_curr_strike[id]))

	Assign_BitVar(stone_spike_active_mask,id,true_for_macro)
	increase_dmg_task(id+SH_SABLINA_SPIKE_CHARGE_TASKID);
}
sablina_delete_charging_sound(id){

	if(is_user_connected(id)){
		emit_sound(id, CHAN_ITEM, NULL_SOUND, VOL_NORM, ATTN_NORM, 0, PITCH_NORM)
		emit_sound(id, CHAN_ITEM, SPIKE_CHARGING_SOUND, VOL_NORM, ATTN_NORM, SND_STOP, PITCH_NORM)
	}
}
public sablina_ku(id)
{
	if ( !sh_is_inround()  || sh_is_freezetime()) return

	if ( !is_user_alive(id) || !sh_get_user_has_hero(id,gHeroID)  ) return

	progressBar(id, 0)

	
	if ( (user_stone_spiker_time[id]/user_charge_time_curr_strike[id]) < cvar_val(float, pcvar_sablina_spike_charge_pct_min) ) {
		
		cancel_sablina_strike(id)

		return
	}
	if(Get_BitVar(stone_spike_active_mask,id)){

		if(Get_BitVar(sablina_switched_weapon_mask,id)){
			// Switch back to previous weapon... Only if power was used...
			if (user_last_weapon[id] != CSW_KNIFE){
				
				shSwitchWeaponID(id, user_last_weapon[id])
				
			}

			Assign_BitVar(sablina_switched_weapon_mask,id,false_for_macro)
		}

		sablina_strike(id)

		
	}
	cancel_sablina_strike(id)

}
put_object_on_wall_from_aimer(aimer_id,ent_id, Float:in_and_out_vec[3]){


	static Float:vOrigin[3]
	pev(aimer_id, pev_origin, vOrigin)

	static Float:vTraceDirection[3], Float:vTraceEnd[3]

	velocity_by_aim(aimer_id, 9999, vTraceDirection)
	vTraceEnd[0] = vTraceDirection[0] + vOrigin[0]
	vTraceEnd[1] = vTraceDirection[1] + vOrigin[1]
	vTraceEnd[2] = vTraceDirection[2] + vOrigin[2]

	new  tr = 0
	engfunc(EngFunc_TraceLine, vOrigin, vTraceEnd, 0, aimer_id, tr)
	get_tr2(tr, TR_vecEndPos, in_and_out_vec)

	free_tr2(tr)

	new Float:fGaps[6], Float:fVec1[3],
		Float:fCurrentGap

	fGaps[0] = -spike_min_dims[0]
	fGaps[1] = spike_max_dims[0]
	fGaps[2] = -spike_min_dims[1]
	fGaps[3] = spike_max_dims[1]
	fGaps[4] = -spike_min_dims[2]
	fGaps[5] = spike_max_dims[2]

	xs_vec_sub(in_and_out_vec, Float:{0.0, 0.0, 9999.9}, fVec1)
	engfunc(EngFunc_TraceLine, in_and_out_vec, fVec1, DONT_IGNORE_MONSTERS, ent_id, 0)
	get_tr2(0, TR_vecEndPos,in_and_out_vec)

	for ( new i = 0; i < 6; i ++ )
	{
		xs_vec_mul_scalar(g_fDirections[i], 9999.9, fVec1)
		xs_vec_add(fVec1, in_and_out_vec, fVec1)
		engfunc(EngFunc_TraceLine, in_and_out_vec, fVec1, DONT_IGNORE_MONSTERS, ent_id, 0)
		get_tr2(0, TR_vecEndPos, fVec1)
		fCurrentGap = xs_vec_distance(in_and_out_vec, fVec1)

		if ( fCurrentGap < fGaps[i] )
		{
			get_tr2(0, TR_vecPlaneNormal, fVec1)
			xs_vec_mul_scalar(fVec1, fGaps[i] - fCurrentGap, fVec1)
			xs_vec_add(in_and_out_vec, fVec1, in_and_out_vec)
		}
	}

	engfunc(EngFunc_SetOrigin, ent_id, in_and_out_vec)
	entity_set_vector(ent_id,EV_VEC_vuser2,in_and_out_vec)
}
public sablina_spike_think(ent_id){


	if ( !is_valid_ent(ent_id) ) return PLUGIN_CONTINUE

	new owner_id = entity_get_edict(ent_id,EV_ENT_owner)
	//if(!is_user_alive(owner_id)||(!(entity_get_int(ent_id, EV_INT_flags)& FL_PARTIALGROUND))){
	if(!is_user_alive(owner_id)){

		remove_entity(ent_id)

		return PLUGIN_CONTINUE;
	}

	new Float:the_radius = 5.0,
					Float:the_damage = 1.0,
					Float:the_drain = 1.0,
					Float:charge_pct = 0.2,
					Float:the_stun_duration = 1.0,
					Float:curr_hp = 1.0,
					Float:hp_pct = 1.0,
					Float:the_cooldown = 1.0;
					
	charge_pct=(user_stone_spiker_time[owner_id]/user_charge_time_curr_strike[owner_id])

	curr_hp =  entity_get_float(owner_id,EV_FL_health);

	hp_pct = get_sablina_health_ratio(curr_hp , floatmax(1.0, float(sh_get_max_hp(owner_id))))

	the_drain = floatmin(charge_pct , cvar_val(float,pcvar_sablina_dmg_frac_hp_max_cut)) * curr_hp
	
	the_damage = (cvar_val(float, pcvar_sablina_spike_min_dmg)
							
							+

	((cvar_val(float, pcvar_sablina_spike_max_dmg) - cvar_val(float, pcvar_sablina_spike_min_dmg))
		
						*
					( hp_pct )
						)) * charge_pct

	
	the_radius = (cvar_val(float, pcvar_sablina_spike_min_radius)
							
							+

	((cvar_val(float, pcvar_sablina_spike_max_radius) - cvar_val(float, pcvar_sablina_spike_min_radius))
		
						*
					( hp_pct )
						)) * charge_pct
	
	the_stun_duration = (cvar_val(float, pcvar_sablina_spike_min_stun_duration)
							
							+

	((cvar_val(float, pcvar_sablina_spike_max_stun_duration) - cvar_val(float, pcvar_sablina_spike_min_stun_duration))
		
						*
					( hp_pct )
						)) * charge_pct



	static entlist[33];
	new numfound = find_sphere_class(ent_id,"player",
					the_radius,
					entlist,
					charsmax(entlist));

	for( new i= 0;(i< numfound);i++){

		new pid = entlist[i];
		if( !is_user_alive(pid) || (pid==owner_id) || sh_clients_are_same_team(pid,owner_id)){
		
			continue
		
		}
		emit_sound(pid,CHAN_BODY,gRockCrashSounds[2],VOL_NORM,ATTN_NORM,0,PITCH_NORM)
		directed_spark(ent_id,pid,10,1,200,20,WHITE,5,0)
		sh_set_stun(pid,the_stun_duration,50.0)
	}
	
	new Float:aim_orig[3]
	entity_get_vector(ent_id, EV_VEC_vuser2,aim_orig)

	new Float:sound_choosing_pct = (the_damage - cvar_val(float, pcvar_sablina_spike_min_dmg))
											/
									(cvar_val(float, pcvar_sablina_spike_max_dmg) - cvar_val(float, pcvar_sablina_spike_min_dmg))



	tank_impact_shot_fx(ent_id,aim_orig,
				floatround(0.1*the_radius),255,75.0,false,true,gRockCrashSounds[floatround(sound_choosing_pct,floatround_round)])
	
	explosion(gHeroID,ent_id,the_radius,the_damage,0.0,1,1,_,
				explosion_sfx_show_shockwave|explosion_sfx_show_smoke,
										LAVENDER,_,stone_spike_wpn_id)

	explosion_custom_entity(ent_id,
							the_radius,
							the_damage,
							"func_breakable",
							0.0,explosion_sfx_flags:0)
	



	sh_extra_damage(owner_id,owner_id,floatround(the_drain,floatround_floor),
					_,_,_,_,_,
					SH_NEW_DMG_DRAIN,
					sablina_stone_spike_recoil_wpn_id)
	the_cooldown = calculate_sablina_cooldown_time(owner_id)

	sh_set_cooldown(owner_id, the_cooldown)


	/*
	
	client_print(owner_id,print_console,"Attack dimensions:^ndamage: %0.2f^nradius: %0.2f^nCooldown: %0.2f^nLoading time: %0.2f^n",
							the_damage,
							the_radius,
							the_cooldown,
							user_charge_time_curr_strike[owner_id])

	*/
	
	Assign_BitVar(stone_spike_out_of_breath,owner_id,true_for_macro)
	user_health_after_last_strike[owner_id] = entity_get_float(owner_id,EV_FL_health)
	new the_array[1]
	the_array[0] = owner_id
	set_task(SABLINA_STONE_SPIKE_DIE_DELAY,"sablina_stone_spike_die_delayed",ent_id+SH_SABLINA_SPIKE_DIE_TASKID,the_array,1)
	

	return PLUGIN_CONTINUE

}
sablina_strike(id){


	new Float:aim_orig[3]
	new ent_id = create_entity("info_target")
	if (!is_valid_ent(ent_id)){
		console_print(id,"Error while creating hitter entity!^n")
		return    
	}

	entity_set_string(ent_id, EV_SZ_classname, SABLINA_SPIKER_CLASSNAME)
	entity_set_edict(ent_id,EV_ENT_owner,id)

	entity_set_vector(ent_id, EV_VEC_mins, spike_min_dims)
	entity_set_vector(ent_id, EV_VEC_maxs, spike_max_dims)


	entity_set_int(ent_id,EV_INT_rendermode, kRenderTransAlpha)
	entity_set_float(ent_id,EV_FL_renderamt,0.0)
	

		
	entity_set_model(ent_id,sablina_rock_spike_mdl_name)


	entity_set_int(ent_id, EV_INT_solid, SOLID_BBOX)
	

	
	put_object_on_wall_from_aimer(id,ent_id,aim_orig)


	entity_set_float(ent_id,EV_FL_nextthink,get_gametime()+0.05)
	

}
public sablina_stone_spike_die_delayed(parms[1],ent_id){

	ent_id-=SH_SABLINA_SPIKE_DIE_TASKID

	if(is_valid_ent(ent_id)){
		if(is_user_alive(parms[0])){
			
			Assign_BitVar(stone_spike_out_of_breath,parms[0],false_for_macro)
			
		}
		if(is_user_connected(parms[0])){

			user_health_after_last_strike[parms[0]] = 0.0
		}
		remove_entity(ent_id)

	}

}
public _sablina_get_hero_id(iPlugins, iParams){


	return gHeroID;

}

public sh_round_new(){


	stone_spike_active_mask = 0;
	remove_entity_name(SABLINA_SPIKER_CLASSNAME)

}

public sh_round_start(){
	static the_players[SH_MAXSLOTS],
			pnum,
			id,
			the_weapons[32],
			wpn_num,
			wpn_item_id,
			bool:dropped_this_person_weapons
	
	get_players(the_players, pnum, "a")
	for (new i = 0; i < pnum; i++) {
		
		id = the_players[i]

		if(!sh_get_user_has_hero(id,gHeroID)){

			continue;
		}
		new Float:the_cooldown = calculate_sablina_cooldown_time(id)

		sh_set_cooldown(id, the_cooldown)
		
		sh_chat_message(id,gHeroID,"Start of rounds. Power will be idle for %0.2f seconds", the_cooldown)
		
		dropped_this_person_weapons = false;

		get_user_weapons(id,the_weapons,wpn_num);


		for (new j = 0; j < wpn_num; j++) {
			
			wpn_item_id = the_weapons[j]
			
			if(!SABLINA_CAN_USE_WPN(wpn_item_id)){

				sh_drop_weapon(id,wpn_item_id,true)
				dropped_this_person_weapons = true;
			}

		}
		if(dropped_this_person_weapons){
			sh_chat_message(id,gHeroID,"The round has ended. %s cannot use any firearms. They got destroyed", gHeroName)
		}
	}
}
//----------------------------------------------------------------------------------------------
public sh_client_spawn(id)
{	
	if(sh_is_active()){
		if ( sh_get_user_has_hero(id,gHeroID) ) {
			

			sh_unset_cooldown_flag(id)
			sh_end_cooldown(id+SH_COOLDOWN_TASKID)
			Assign_BitVar(stone_spike_active_mask,id,false_for_macro)
		}
	}
	
}
//----------------------------------------------------------------------------------------------
public sh_client_death(id)
{	
	if(sh_is_active()){
		if ( sh_get_user_has_hero(id,gHeroID) ) {
			

			Assign_BitVar(stone_spike_active_mask,id,false_for_macro)
		}
	}
	
}

public dmg_fwd_ret_id:sh_extra_damage_fwd_pre(&victim, &attacker, &damage, &my_hitpoint_enum:bodypart,&sh_damage_mode:dmgMode, &sh_extra_damage_flags:sh_extra_dmg_flags, const Float:dmgOrigin[3],&dmg_type,&sh_thrash_brat_dmg_type:new_dmg_type, custom_weapon_id){
	if ( !sh_is_active() || !is_user_alive(victim) || !is_user_alive(attacker)){
	
		return DMG_FWD_PASS
	}
	if(sh_clients_are_same_team(victim,attacker)){
		return DMG_FWD_PASS
	}
	if(!sh_get_user_has_hero(victim,gHeroID)){
		return DMG_FWD_PASS
	}
	new dmg_fwd_ret_id:the_return_value=DMG_FWD_PASS
	switch(new_dmg_type){

		/*

			she is immune to some damage types
			regardless of where it comes from
			And immune to others
			ONLY
			if NOT self inflicted
			She cannot suffocate, clense or damage herself with any conventional super bullet
			but she can get auto-damaged (damaged from herself)
			by drain damage
			(her gimmick special move "Drains" her)
			
			this hero is still kind of complicated and conflicted in my head
			I want to make cleaner eventually.

			

		*/
		/*
			TODO: I still dont know

			at

			friday 16 october 2026 10:01:39 WEST

			how Im going to make her stone spike look visually cooler
		*/

		case SH_NEW_DMG_BLEED,
					SH_NEW_DMG_DRAIN:{

				the_return_value = ((victim==attacker) ? DMG_FWD_PASS:  DMG_FWD_BLOCK)


		}
		case SH_NEW_DMG_SUPER_BULLET,
					SH_NEW_DMG_TR45H_GUN,
					SH_NEW_DMG_SUFFOCATION,
					SH_NEW_DMG_CLEANSE:{


				the_return_value = DMG_FWD_BLOCK
		}
		default:{

			the_return_value=DMG_FWD_PASS
		}



	}
	
	return the_return_value
}
