	pcvar_sablina_spike_min_dmg = create_cvar("sablina_spike_min_dmg", "100.0")
	pcvar_sablina_spike_max_dmg = create_cvar("sablina_spike_max_dmg", "500.0")
	pcvar_sablina_spike_min_cooldown = create_cvar("sablina_spike_min_cooldown", "5.0")
