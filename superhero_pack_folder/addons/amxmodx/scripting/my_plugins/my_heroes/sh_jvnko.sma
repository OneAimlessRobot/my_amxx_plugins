#define I_WANT_CONSTANTS
#define I_WANT_QUICK_CHECKS
#define I_WANT_MISC_FUNCS
#define I_WANT_CUSTOM_WEAPONS
#include "../my_include/superheromod.inc"
#include "sh_aux_stuff/sh_aux_inc.inc"
#include "jvnko_inc/jvnko.inc"
#include "sh_aux_stuff/sh_aux_stuff_natives_pt14.inc"
#include "custom_grenades/custom_grenades.inc"
#include "../my_include/my_author_header.inc"
// GLOBAL VARIABLES

new gHeroID

stock const gHeroName[] = "Jvnko"



new JVnk0_tr45h_gun_short_name[SAFE_BUFFER_SIZE+1]="JVnk0_tr45h_gun"
new JVnk0_tr45h_gun_long_name[SAFE_BUFFER_SIZE+1]="JVnk0_tr45h_gun"
new JVnk0_tr45h_gun_wpn_id = -1


//nums

new pcvar_num_conc_grens

//floats
new pcvar_dmg_mult

//----------------------------------------------------------------------------------------------
public plugin_init()
{
	// Plugin Info
	register_plugin("SUPERHERO Jvnko", "1.0", AUTHOR)
	
	
	// DO NOT EDIT THIS FILE TO CHANGE CVARS, USE THE SHCONFIG.CFG
	create_cvar("jvnko_level", "7")
	pcvar_num_conc_grens = create_cvar("jvnko_num_conc_grens", "5")
	pcvar_dmg_mult = create_cvar("jvnko_dmg_mult", "3.0")
	
	set_pcvar_bounds(pcvar_num_conc_grens,CvarBound_Lower,true, 5.0)
	set_pcvar_bounds(pcvar_dmg_mult,CvarBound_Lower,true, 1.0)

	gHeroID=shCreateHero(gHeroName, "Scavenger!", "Weapons picked up from OTHER people get extra damage!", false, "jvnko_level" )
	
	JVnk0_tr45h_gun_wpn_id=sh_log_custom_damage_source(
								gHeroID,
								JVnk0_tr45h_gun_short_name,
								JVnk0_tr45h_gun_long_name,
								0)

	
	register_ham_hook_multiple(Ham_TraceAttack,
						full_entity_array_for_trace_attack,
						length_of_trace_attack_entity_array,
						"jvnko_tracer_red",
						1,
						true)
	sh_assign_hero_bit(gHeroID, SH_TR45H_HERO, true);

	RegisterHam(Ham_TraceAttack,"player","Jvnko_Damage",_,true)
	
	
	
}
public plugin_natives(){

	register_native("jvnko_get_hero_id","_jvnko_get_hero_id")
}

public _jvnko_get_hero_id(iPlugins, iParams){


	return gHeroID;

}
public jvnko_tracer_red(Victim, Attacker, Float:Damage, Float:Direction[3], Ptr, DamageBits)
{
	if(!sh_is_active() ||  !is_user_alive(Attacker)){
		return
	}
	new bool:the_bool_to_use=sh_get_id_bit(Attacker,SH_IS_TR45H_GUN_EQUIPPED)
	generic_weapon_tracer_logic(Attacker,the_bool_to_use,_,gHeroID,true,sh_custom_color:{RED,RED,RED})

}
public Jvnko_Damage(Victim, Attacker, Float:Damage, Float:Direction[3], Ptr, DamageBits){
	
	if(Damage<=0.0){
		return HAM_IGNORED
	}

	if ( !sh_is_active() || !is_user_alive(Victim) ) return HAM_IGNORED


	new my_hitpoint_enum:the_hitpoint= my_hitpoint_enum:get_tr2(Ptr,TR_Hitgroup)

	new bool:has_hero= bool:sh_get_user_has_hero(Attacker,gHeroID) 

	if (!is_user_connected(Attacker)) return HAM_IGNORED

	if ( has_hero  && sh_get_id_bit(Attacker,SH_IS_TR45H_GUN_EQUIPPED) && !sh_clients_are_same_team(Attacker,Victim)) {
		
		new Float:extraDamage = Damage * cvar_val(float,pcvar_dmg_mult)- Damage
		
		if (extraDamage > 0.0){
			
			sh_extra_damage(Victim, Attacker, floatround(extraDamage),
											the_hitpoint,
											SH_DMG_NORM,
											SH_EXTRA_DMG_FLAG_STUN,
											_,_,
											SH_NEW_DMG_TR45H_GUN,
											JVnk0_tr45h_gun_wpn_id)
		}
	}
	
	return HAM_IGNORED
	
	
	
}
//----------------------------------------------------------------------------------------------
public sh_client_spawn(id)
{	
	if(sh_is_active()&&is_user_alive(id)){
		if ( sh_get_user_has_hero(id,gHeroID) ) {
			
			jvnko_weapons(id)
		}
	}
	
}

public jvnko_weapons(id)
{
	if ( sh_is_active() && sh_get_user_has_hero(id,gHeroID) &&is_user_alive(id)) {
		give_custom_grenades(id,GREN_CONC,cvar_val(num, pcvar_num_conc_grens))
		
	}
}