// GLOBAL VARIABLES



#define gHeroName "Larissa (Guts n Heroin)"

new g_larissa_points[SH_MAXSLOTS+1]
new g_larissa_kills[SH_MAXSLOTS+1]



//new gHeroLevel
new pcvar_base_er_points
new pcvar_max_er_points
new pcvar_dmg_speed_er_points_pct
new pcvar_num_er_darts
new pcvar_num_mollies


//----------------------------------------------------------------------------------------------
public plugin_init()
{
	// Plugin Info
	register_plugin("SUPERHERO Larissa", "1.0", AUTHOR)
	
	
	// DO NOT EDIT THIS FILE TO CHANGE CVARS, USE THE SHCONFIG.CFG
	create_cvar("larissa_level", "8")
	pcvar_base_er_points = create_cvar("larissa_base_points", "1000")
	pcvar_dmg_speed_er_points_pct = create_cvar("larissa_dmg_speed_points_pct", "2.0")
	pcvar_max_er_points = create_cvar("larissa_max_points", "1000")
	pcvar_num_er_darts = create_cvar("larissa_num_darts", "100")
	pcvar_num_mollies = create_cvar("larissa_num_mollies", "0")
	
	gHeroID=shCreateHero(gHeroName, "Larissa!", "Grab attention by killin and get fastaa", false, "larissa_level" )
	
	RegisterHam(Ham_TakeDamage,"player","larissa_ham_damage",1,true)
	
	sh_register_superheromod_weapon_model(gHeroID,CSW_KNIFE,NAVALHA_V_MODEL,NAVALHA_P_MODEL)
	sh_register_superheromod_weapon_model(gHeroID,CSW_ELITE,TRANQS_V_MODEL,TRANQS_P_MODEL)
	
	
	sh_assign_hero_projectile_weapon_bit(gHeroID,my_weapon_ids:DART_GUN_WEAPON_CLASSID,true)
	
	
}

public plugin_natives(){

	
	
	register_native("larissa_get_hero_id","_larissa_get_hero_id");
	
	register_native("larissa_get_is_max_points","_larissa_get_is_max_points");
	

}
public bool:_larissa_get_is_max_points(iPlugin,iParams){

	new id= get_param(1)
	return g_larissa_points[id]>=cvar_val(num, pcvar_max_er_points);


}

public _larissa_get_hero_id(iPlugin,iParams){
	return gHeroID
}

prepare_larissa(id){

	g_larissa_kills[id]=0;
	g_larissa_points[id] = cvar_val(num, pcvar_base_er_points);
	

	
}
//----------------------------------------------------------------------------------------------
public sh_hero_init(id, heroID, sh_init_mode:mode){
	if(heroID!=gHeroID) return

	if(sh_get_user_has_hero(id, gHeroID)){
		prepare_larissa(id)
		larissa_weapons(id)
		
	}
	else{

		tranq_set_user_tranq(id, false,0)
		sh_reset_max_speed(id)
		g_larissa_points[id]=0;
		g_larissa_kills[id]=0;
		hook_set_hook(id,0)
	}
	
	
}

public larissa_ham_damage(id, idinflictor, attacker, Float:damage, damagebits)
{
	if(damage <= 0.0){

		return HAM_IGNORED
	}
	if ( !sh_is_active() || !is_user_alive(id)||!is_user_alive(attacker)){

		return HAM_IGNORED
	}

	if(attacker == id) return HAM_IGNORED 
	new my_hitpoint_enum:the_hitpoint = my_hitpoint_enum:get_pdata_int(id, m_iLastHitGroup, XO_PLAYER)
	
	pev(id, pev_dmg_take, damage)

	return do_bleed_knife_attack(id,attacker,gHeroID,30,40,sh_get_user_has_hero(attacker,gHeroID),_,_,1,the_hitpoint)


	
}
//----------------------------------------------------------------------------------------------
public sh_client_spawn(id)
{	
	if(sh_is_active()&&is_user_alive(id)){
		if ( sh_get_user_has_hero(id,gHeroID) ) {
			prepare_larissa(id)
			larissa_weapons(id)
		}
	}
	
}
public client_disconnected(id){
	
	g_larissa_points[id]=0;
	g_larissa_kills[id]=0;
	hook_set_hook(id,0)
}


add_speed_points(id,Float:damage){
	
	g_larissa_points[id]=min(cvar_val(num, pcvar_max_er_points),
				g_larissa_points[id]+(floatround(damage*
					cvar_val(float, pcvar_dmg_speed_er_points_pct))))
	
}

public dmg_fwd_ret_id:sh_extra_damage_fwd_pre(&victim, &attacker, &damage,  &my_hitpoint_enum:bodypart,&sh_damage_mode:dmgMode, &sh_extra_damage_flags:sh_extra_dmg_flags, const Float:dmgOrigin[3],&dmg_type,const sh_thrash_brat_dmg_type:new_dmg_type,const custom_weapon_id, &bool:values_should_change){



	if(damage <= 0){
            
		return DMG_FWD_PASS
	}
	
	if ( !sh_is_active() || !is_user_alive(victim) || !is_user_alive(attacker)){

		return DMG_FWD_PASS
	}
	if(sh_clients_are_same_team(attacker,victim)||(attacker==victim)){

		return DMG_FWD_PASS

	}
	if((new_dmg_type==SH_NEW_DMG_FIRE)||(new_dmg_type==SH_NEW_DMG_BLEED)){
		if(sh_get_user_has_hero(attacker,gHeroID) ){
			aura(attacker,LineColors[PINK])
			add_speed_points(attacker, float(damage))
		}
	}

	return DMG_FWD_PASS
}
public larissa_weapons(id)
{
if ( sh_is_active() && sh_get_user_has_hero(id,gHeroID) &&is_user_alive(id)) {
	give_custom_grenades(id,GREN_MOLLY,cvar_val(num, pcvar_num_mollies))
	
	tranq_set_user_tranq(id, true,cvar_val(num, pcvar_num_er_darts))

	hook_set_hook(id,1)
}
}

public sh_client_death(killed,killer)
{

	static killer_name[128]
	get_user_name(killer,killer_name,127)
	if(sh_get_user_has_hero(killer,gHeroID)&&(killed!=killer)){
		
		g_larissa_kills[killer]++;
		sh_apply_staged_stat_boost(killer,killer,STAT_SPEED_ID,1,true)
		
	
	}
	
}
