#define I_WANT_CONSTANTS
#define I_WANT_MISC_FUNCS
#define I_WANT_PDATA_ALIASES
#define I_WANT_BASIC_MACROS
#include "../my_include/superheromod.inc"
#include "special_fx_inc/sh_yakui_get_set.inc"
#include "special_fx_inc/sh_gatling_special_fx.inc"
#include "special_fx_inc/sh_gatling_funcs.inc"
#include "special_fx_inc/sh_rpsyringe_funcs.inc"
#include "special_fx_inc/sh_needle_funcs.inc"
#include "sh_aux_stuff/sh_aux_inc.inc"
#include "./superheromod_help_files_includes/superheromod_help_files.inc"
#include "../my_include/my_author_header.inc"
#include "sh_aux_stuff/sh_aux_stuff_natives_pt5.inc"
#include "custom_grenades/custom_grenades.inc"


// GLOBAL VARIABLES



#define gHeroName "Yakui Mk2"


new pcvar_max_pills
new pcvar_max_rockets

//----------------------------------------------------------------------------------------------
public plugin_init()
{
	// Plugin Info
	register_plugin("SUPERHERO Yakui the Maid pt 2", "1.0", AUTHOR)
	
	
	// DO NOT EDIT THIS FILE TO CHANGE CVARS, USE THE SHCONFIG.CFG
	create_cvar("yakui_level", "8")
	pcvar_max_pills = create_cvar("yakui_pills","1000")
	pcvar_max_rockets = create_cvar("yakui_rockets","5")
	
	gHeroID=shCreateHero(gHeroName, "Yakui the Maid Mk2", "NARCOTIC ARTILLERY", true, "yakui_level" )
	
	superheromod_help_link_hero(gHeroID, "Yakui the maid: Help file","yakui_folder/","yakui_help_file.html")
	
	sh_assign_hero_bit(gHeroID, SH_BOT_RESTRICTED, true)
	
	sh_assign_hero_bit(gHeroID, SH_M249_HERO, true)
	
	sh_register_superheromod_model(gHeroID,
								"models/player/yakui/yakui.mdl",
								"models/player/yakui/yakui.mdl",
								"yakui",
								"Ready for a trip?",
								"Hmpf...")



	sh_assign_hero_projectile_weapon_bit(gHeroID,my_weapon_ids:YAKUI_WEAPON_CLASSID,true)


}
public plugin_natives(){
	register_native("yakui_get_hero_id","_yakui_get_hero_id");
}

public _yakui_get_hero_id(iPlugin,iParams){
	return gHeroID
}
//----------------------------------------------------------------------------------------------
public sh_hero_init(id, heroID, sh_init_mode:mode){
	if(heroID!=gHeroID) return

	if(sh_get_user_has_hero(id, gHeroID)){
		init_yakui(id)
		
	}
	else{
	
		clear_yakui(id)
		gatling_set_user_pillgatling(id,false)
	}
	
}

init_yakui(id){

	gatling_set_num_rockets(id,cvar_val(num, pcvar_max_rockets))
	gatling_set_pillgatling(id,1)
	gatling_set_rockets(id,0)
	gatling_set_needle(id,0)
	yakui_weapons(id)



}
reset_yakui(id){

	if(!sh_is_active()||!sh_get_user_has_hero(id,gHeroID)) return;
	
	gatling_set_num_rockets(id,cvar_val(num, pcvar_max_rockets))
	yakui_weapons(id)



}
clear_yakui(id){

	gatling_set_num_rockets(id,0)
	gatling_set_user_pillgatling(id,true,0)



}
public yakui_weapons(id){

if ( sh_is_active() && is_user_alive(id) && sh_get_user_has_hero(id,gHeroID) ) {
	gatling_set_user_pillgatling(id,true,cvar_val(num, pcvar_max_pills))
	give_custom_grenades(id,GREN_RANDOM_FX,10)
}

}

//----------------------------------------------------------------------------------------------
public sh_client_spawn(id)
{
	if(!is_user_alive(id)|| !sh_is_active()) return
	
	sh_uneffect_user(id)
	if ( sh_get_user_has_hero(id,gHeroID)) {
		
		reset_yakui(id)
		
	}
	
}


//----------------------------------------------------------------------------------------------
public sh_hero_key(id, heroID, sh_key_mode:key)
{
if ( gHeroID != heroID ||!sh_get_user_has_hero(id,gHeroID) ) return

switch(key)
{
	case SH_KEYDOWN: {
		yakui_kd(id)
	}
}
}
public yakui_kd(id){

	new clip,ammo,wid=get_user_weapon(id,clip,ammo)
	if ( !is_user_alive(id)||!sh_get_user_has_hero(id,gHeroID)||sh_is_freezetime()||((wid!=YAKUI_WEAPON_CLASSID)&&(wid!=CSW_KNIFE))) {
		return PLUGIN_HANDLED
	}


	
	switch(wid){
	
		case YAKUI_WEAPON_CLASSID:{
			if(gatling_get_pillgatling(id)){
				make_effect(id,id,5.0,gHeroID)
				gatling_dec_num_pills(id)
			}
			
		}
		case CSW_KNIFE:{
			if(gatling_get_needle(id)){
				make_effect(id,id,5.0,gHeroID,gatling_get_needle_fx(id))
				gatling_needle_cycle_fx(id)
			}

		}
	}

	return PLUGIN_HANDLED
}
