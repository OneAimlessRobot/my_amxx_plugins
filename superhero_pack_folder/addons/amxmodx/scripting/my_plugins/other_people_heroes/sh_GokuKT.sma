/* CVARS - copy and paste to shconfig.cfg
//gokukt
gokukt_level 0
gokukt_cooldown 30  //# of seconds before Goku can use the Kaioken technic again
gokukt_kaiokentime 7  //# of seconds Goku has in Kaioken mode.
gokukt_speed 1000 // How fast can goku run is kaioken mode
gokukt_armor 1000 // How much armor does goku have in kaioken mode
gokukt_health 800 // How much HP does goku have in kaioken mode.
*/

#define I_WANT_CONSTANTS
#define I_WANT_QUICK_CHECKS
#define I_WANT_CUSTOM_COLORS
#include "../my_heroes/sh_aux_stuff/sh_aux_stuff_natives_pt11.inc"
#include <amxmodx>
#include "../my_include/superheromod.inc"
#include "../my_heroes/sh_aux_stuff/sh_aux_inc.inc"
#include "../my_heroes/bleed_knife_inc/sh_bknife_fx.inc"
#include "../my_heroes/sh_aux_stuff/sh_aux_stuff_natives_pt16.inc"

// GLOBAL VARIABLES
new HeroName[] = "Saiyan Kaioken Technic"

new GokuKTTimer[SH_MAXSLOTS+1]
//reset variables
new bool:reset_speed[SH_MAXSLOTS+1], bool:reset_health[SH_MAXSLOTS+1], bool:reset_armor[SH_MAXSLOTS+1]
new goku_kt_dmg_boost_wpn_short_name[SAFE_BUFFER_SIZE+1]="goku_kt_dmg_boost"
new goku_kt_dmg_boost_dmg_boost_wpn_log_name[SAFE_BUFFER_SIZE+1]="goku_kt_dmg_boost"
new goku_kt_dmg_boost_wpn_id = -1

//pcvar holders
new goku_speed, goku_hp, goku_ap, goku_time, goku_cooldown

//pcvar holders (floats)


new goku_kt_dmg_mult = -1,
	goku_kt_dmg_res = -1

new g_spritePowerUp
//----------------------------------------------------------------------------------------------
public plugin_init()
{
	// Plugin Info
	register_plugin("SUPERHERO Goku's Kaioken Technic", "3.0", "MEGA/SOEN/BONINI")
	// DO NOT EDIT THIS FILE TO CHANGE CVARS, USE THE SHCONFIG.CFG
	create_cvar("gokukt_level", "12")
	goku_cooldown = create_cvar("gokukt_cooldown", "45")
	goku_time = create_cvar("gokukt_kaiokentime", "5")
	goku_speed = create_cvar("gokukt_speed", "5000.0")
	goku_ap = create_cvar("gokukt_armor", "5000")
	goku_hp = create_cvar("gokukt_health", "800")
	goku_kt_dmg_mult = create_cvar("gokukt_dmg_mult", "5.0")
	goku_kt_dmg_res = create_cvar("gokukt_dmg_res", "0.3")
	
	// FIRE THE EVENT TO CREATE THIS SUPERHERO!
	gHeroID=shCreateHero(HeroName, "Goku's Kaioken Technic", "Go into Kaiokenmode for X Seconds", true, "gokukt_level")
	
	goku_kt_dmg_boost_wpn_id=sh_log_custom_damage_source(
							gHeroID,
							goku_kt_dmg_boost_wpn_short_name,
							goku_kt_dmg_boost_dmg_boost_wpn_log_name,
							0)
	
	RegisterHam(Ham_TakeDamage,"player","Kaioken_Damage",1,true)

	// LOOP
	set_task(1.0, "gokukt_loop", 0, "", 0, "b") //forever loop
	 
}
public Kaioken_Damage(id, idinflictor, attacker, Float:damage, damagebits){
	
	if(damage<=0.0){
		return HAM_IGNORED
	}

	if ( !sh_is_active() || !is_user_alive(id) ) return HAM_IGNORED


	if (!is_user_connected(attacker) || (id == attacker)) return HAM_IGNORED


	new weapon, my_hitpoint_enum:the_hitpoint
	get_user_attacker(id, weapon, _:the_hitpoint)
	pev(id, pev_dmg_take, damage)

	new bool:has_hero= bool:sh_get_user_has_hero(attacker,gHeroID) 

	//I had to tell her not to bleed her teammates
	if ( has_hero && ( GokuKTTimer[attacker] >0 ) &&  !sh_clients_are_same_team(attacker,id)) {
		
		
		new rounded_dmg = floatround(damage)

		if(rounded_dmg > 0){
			sh_extra_damage(id, attacker, rounded_dmg,
											the_hitpoint,
											SH_DMG_NORM,
											SH_EXTRA_DMG_FLAG_STUN,
											_,_,
											SH_NEW_DMG_ENERGY_BLAST,
											goku_kt_dmg_boost_wpn_id)
		}
	}
	
	return HAM_IGNORED
	
	
	
}

public dmg_fwd_ret_id:sh_extra_damage_fwd_pre(&victim, &attacker, &damage,  &my_hitpoint_enum:bodypart,&sh_damage_mode:dmgMode, &sh_extra_damage_flags:sh_extra_dmg_flags, const Float:dmgOrigin[3],&dmg_type,const sh_thrash_brat_dmg_type:new_dmg_type,const custom_weapon_id){
	if ( !sh_is_active() || !is_user_alive(victim) || !is_user_alive(attacker)){
	
		return DMG_FWD_PASS
	}
	new bool:attacker_is_kaioken= ((GokuKTTimer[attacker] >0 ) && sh_get_user_has_hero(attacker,gHeroID)) 
	new bool:victim_is_kaioken= ((GokuKTTimer[victim] >0 ) && sh_get_user_has_hero(victim,gHeroID))

	new dmg_fwd_ret_id:result= DMG_FWD_PASS
	if(CUSTOM_DMG_TYPE_IS_DBZ(new_dmg_type)){
		if(attacker_is_kaioken ){
			damage *= (floatround(cvar_val(float,goku_kt_dmg_mult)))
			result = DMG_FWD_HANDLED
		}
	}
	if(CUSTOM_DMG_TYPE_IS_PHYSICAL(new_dmg_type)){
		if(victim_is_kaioken){
			new dmg_to_subtract = (floatround(float(damage) * cvar_val(float,goku_kt_dmg_res)))
			damage -= dmg_to_subtract
			result = DMG_FWD_HANDLED
		}
	}
	return result
}

//----------------------------------------------------------------------------------------------
public plugin_precache()
{
	engfunc(EngFunc_PrecacheSound,"shmod/kaiokenbonini.wav")
	g_spritePowerUp = engfunc(EngFunc_PrecacheModel,"sprites/shmod/kaiokenbonini.spr")
}

//----------------------------------------------------------------------------------------------
public sh_hero_init(id, heroID, sh_init_mode:mode){
	if(heroID!=gHeroID) return
	
	if(!sh_get_user_has_hero(id,gHeroID))
	{
		if ( is_user_connected(id)) {
			GokuKTTimer[id] = 0
		}
	}
}
//----------------------------------------------------------------------------------------------
public sh_client_spawn(id)
{
	reset_speed[id] = false
	reset_health[id] = false
	reset_armor[id] = false
	GokuKTTimer[id] = 0
}

//----------------------------------------------------------------------------------------------
public sh_hero_key(id, heroID, sh_key_mode:key)
{
if ( gHeroID != heroID ||!sh_get_user_has_hero(id,gHeroID) ) return

switch(key)
{
	case SH_KEYDOWN: {
		gokukt_kd(id)
	}
}
}
//----------------------------------------------------------------------------------------------
// RESPOND TO KEYDOWN
public gokukt_kd(id)
{
	if ( sh_is_freezetime() ) return;
	
	if ( !is_user_alive(id) ) return;
	
	// Let them know they already used their ultimate if they have
	if ( sh_get_cooldown_flag(id)) {
		sh_sound_deny(id)
		return
	}
	// Make sure they're not in the middle of Kaioken already
	if ( GokuKTTimer[id] > 0 ) return;
	
	GokuKTTimer[id] = get_pcvar_num(goku_time) + 1
	gokukt_kaiokenmode(id)
	sh_set_cooldown(id, get_pcvar_float(goku_cooldown))
}
//----------------------------------------------------------------------------------------------
public gokukt_loop()
{
	for ( new id = 1; id < sh_maxplayers()+1; id++ ) {
		if (sh_get_user_has_hero(id,gHeroID) && is_user_alive(id) && GokuKTTimer[id] >= 0 ) {
			if ( GokuKTTimer[id] > 0 ) {
				GokuKTTimer[id]--
				set_render_with_color_const(id,RED,1,255,
						_,
						0,_,
						1.0,0,_,kRenderNormal,PRIO_RENDER_POWERUP,gHeroID)
				set_hudmessage(255, 0, 0, -1.0, 0.3, 0, 1.0, 1.0, 0.0, 0.0)
				show_hudmessage(id, "%d seconds left of Kaioken Mode", GokuKTTimer[id])
			}
			else if ( GokuKTTimer[id] == 0 ) {
				GokuKTTimer[id] = -1
				end_kaioken(id)
			}
		}
	}
}
//----------------------------------------------------------------------------------------------
public end_kaioken(id)
{
	new set_health = get_pcvar_num(goku_hp) - get_user_health(id)
	new set_armor = get_pcvar_num(goku_ap) - get_user_armor(id)
	if ( set_health < 1 ) set_health = 100;
	if ( set_armor < 1 ) set_armor = 100;
	
	if ( reset_speed[id] ) {
		sh_reset_max_speed(id)
		reset_speed[id] = false
	}
	if ( reset_health[id] ) {

		
		sh_set_hp(id, set_health)

		reset_health[id] = false

		sh_bleed_user(id,id,BLEED_MINI,gHeroID,0,MY_HIT_GENERIC)
		
	}
	if ( reset_armor[id] ) {
		set_user_armor(id, set_armor)
		reset_armor[id] = false
	}
}
//----------------------------------------------------------------------------------------------
public gokukt_kaiokenmode(id)
{
	if ( sh_get_user_has_hero(id,gHeroID)&& is_user_alive(id) ) {
		new parm[2]
		parm[0] = id
		parm[1] = 5
		if ( get_pcvar_float(goku_speed) > get_user_maxspeed(id) ) {
			set_user_maxspeed(id, get_pcvar_float(goku_speed));
			reset_speed[id] = true
		}
		
		if ( get_pcvar_num(goku_hp) > get_user_health(id) ) {
			sh_set_hp(id, get_pcvar_num(goku_hp),get_pcvar_num(goku_hp),true);
			reset_health[id] = true
		}
		
		if ( get_pcvar_num(goku_ap) > get_user_armor(id) ) {
			set_user_armor(id, get_pcvar_num(goku_ap));
			reset_armor[id] = true
		}
			
			
		set_hudmessage(255, 0, 0, -1.0, 0.3, 0, 0.25, 1.0, 0.0, 0.0)
		show_hudmessage(id, "5 Times x Kaioken! Haaaa!")
		emit_sound(0, CHAN_AUTO, "shmod/kaiokenbonini.wav", VOL_NORM, ATTN_NORM, 0, PITCH_NORM)
		powerup_effect(parm)
		set_task(0.1, "powerup_effect", 0, parm, 2, "a", 85)
	}
}

public powerup_effect(parm[])
{
	if ( !sh_is_active()) return

	new id = parm[0]

	if ( !is_user_alive(id) ) return

	new Size = parm[1]
	new players[SH_MAXSLOTS], pnum
	new idOthers, Origin[3]

	get_players(players, pnum, "ah")

	// Show a powerup to all alive players except the one being powered up.
	for (new i = 0; i < pnum; i++) {
		idOthers = players[i]
		if ( !is_user_alive(idOthers)) continue

		get_user_origin(id, Origin)

		// power up sprite - additive sprite, plays 1 cycle
		message_begin(MSG_ONE, SVC_TEMPENTITY, Origin, idOthers)
		write_byte(17)			// TE_SPRITE
		write_coord(Origin[0])	// center position
		write_coord(Origin[1])
		write_coord(Origin[2]+20)
		write_short(g_spritePowerUp)	// sprite index
		write_byte(Size)		// scale in 0.1's
		write_byte(50)			// brightness
		message_end()

		// power up sprite - additive sprite, plays 1 cycle
		message_begin(MSG_ONE, SVC_TEMPENTITY, Origin, idOthers)
		write_byte(17)			// TE_SPRITE
		write_coord(Origin[0]+5) // center position
		write_coord(Origin[1])
		write_coord(Origin[2]+20)
		write_short(g_spritePowerUp)	// sprite index
		write_byte(Size)		// scale in 0.1's
		write_byte(50)			// brightness
		message_end()

		// power up sprite - additive sprite, plays 1 cycle
		message_begin(MSG_ONE, SVC_TEMPENTITY, Origin, idOthers)
		write_byte(17)			// TE_SPRITE
		write_coord(Origin[0]-5)	// center position
		write_coord(Origin[1])
		write_coord(Origin[2]+20)
		write_short(g_spritePowerUp)	// sprite index
		write_byte(Size)		// scale in 0.1's
		write_byte(50)			// brightness
		message_end()

		// power up sprite - additive sprite, plays 1 cycle
		message_begin(MSG_ONE, SVC_TEMPENTITY, Origin, idOthers)
		write_byte(17)			// TE_SPRITE
		write_coord(Origin[0])	// center position
		write_coord(Origin[1]+5)
		write_coord(Origin[2]+10)
		write_short(g_spritePowerUp)	// sprite index
		write_byte(Size)		// scale in 0.1's
		write_byte(50)			// brightness
		message_end()

		// power up sprite - additive sprite, plays 1 cycle
		message_begin(MSG_ONE, SVC_TEMPENTITY, Origin, idOthers)
		write_byte(17)			// TE_SPRITE
		write_coord(Origin[0])	// center position
		write_coord(Origin[1]-5)
		write_coord(Origin[2]+10)
		write_short(g_spritePowerUp)	// sprite index
		write_byte(Size)		// scale in 0.1's
		write_byte(50)			// brightness
		message_end()
	}
}
